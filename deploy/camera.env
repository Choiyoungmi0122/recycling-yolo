# 카메라 / ROI 설정 - 수정 후 컨테이너만 다시 실행하면 적용 (이미지 재빌드 불필요)
#
# ROI 맞추는 방법:
#   1) 서비스 실행 후 브라우저에서 http://<orin>:8765/full.jpg 열기
#      (원본 전체 화면 + 100px 좌표 격자 + 현재 ROI 빨간 사각형)
#   2) 격자 좌표를 보고 아래 ROI 값 수정
#   3) ./deploy/run_orin.sh run  다시 실행

# 원본 frame 에서 잘라 쓸 영역: x1 y1 x2 y2  (비우면 ROI 없이 전체 사용)
ROI="240 150 1400 932"

# CSI 카메라 (IMX219)
# CSI_SENSOR_ID: Argus 가 인식한 카메라 순서 (물리 포트 CAM0/CAM1 이 아님)
#   카메라 1대 설정(Jetson-IO 'IMX219-A' 또는 'IMX219-C')이면 어느 포트든 0
#   2대 설정('IMX219 Dual')이면 포트 순서대로 0, 1
CSI_SENSOR_ID=0
CSI_SENSOR_MODE=3
CSI_WIDTH=1640
CSI_HEIGHT=1232
CSI_FPS=30
CSI_FLIP=6

# 판정
CONF=0.25
VOTE_WINDOW=5
VOTE_REQUIRED=3
